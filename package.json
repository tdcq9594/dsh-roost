{
  "name": "dsh-roost",
  "version": "1.1.4",
  "description": "把 QQ 开放平台的官方机器人接进 DeepSeek Harness：接入向导一键装好内核与对话插件，每个会话独立持久上下文，三层记忆（事实/日记/图谱），情绪状态影响主动搭话，按说话人分档收放本地工具，扩展以 MCP server 形式装载。",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "persona-index": "node scripts/build-persona-index.mjs",
    "persona-index:check": "node scripts/build-persona-index.mjs --check",
    "ext-docs": "node scripts/build-ext-docs.mjs",
    "ext-docs:check": "node scripts/build-ext-docs.mjs --check",
    "mutate": "node scripts/mutate.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "qq-bot",
    "qqbot",
    "im-bridge",
    "memory",
    "agent",
    "ai-companion",
    "roost"
  ],
  "files": [
    "src",
    "client",
    "scripts/backup.mjs",
    "personas",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE",
    "examples",
    "scripts/build-ext-docs.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdcq9594/dsh-roost.git"
  },
  "homepage": "https://github.com/tdcq9594/dsh-roost",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "dsh-roost",
  "version": "1.0.9",
  "description": "给 QQ 机器人接上 DSH 的全部能力：工具、记忆、上下文压缩、主动搭话，带一键接入",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "persona-index": "node scripts/build-persona-index.mjs",
    "persona-index:check": "node scripts/build-persona-index.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "qq-bot",
    "qqbot",
    "im-bridge",
    "memory",
    "agent",
    "ai-companion",
    "roost"
  ],
  "files": [
    "src",
    "client",
    "scripts/backup.mjs",
    "personas",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdcq9594/dsh-roost.git"
  },
  "homepage": "https://github.com/tdcq9594/dsh-roost",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
